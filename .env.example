# Minecraft Server Configuration
MINECRAFT_HOST=Rushibadmosh.aternos.me
MINECRAFT_PORT=26261
MINECRAFT_VERSION=26.3
MINECRAFT_USERNAME=JarvisBot
MINECRAFT_PASSWORD=
MINECRAFT_AUTH_TYPE=offline

# Google Gemini AI Brain Configuration
# Acquire your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
